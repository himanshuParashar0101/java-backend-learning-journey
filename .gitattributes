# Automatically detect text files
* text=auto

# Repository text files use Unix line endings
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Maven Wrapper shell script must use LF for Linux/macOS
mvnw text eol=lf

# Windows command scripts use CRLF
*.cmd text eol=crlf